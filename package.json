{
  "name": "sgt-holding",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "admin": "node --env-file-if-exists=.env scripts/admin.mjs",
    "build:pages": "tsc -b && vite build --mode pages && node scripts/prepare-pages.mjs",
    "test:pages": "playwright test --config=playwright.pages.config.ts",
    "build:host0": "npm run build && node scripts/prepare-host0.mjs",
    "test:host0": "node scripts/test-host0.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
