Options -Indexes
DirectoryIndex index.html
RewriteEngine On
RewriteRule ^\.well-known/acme-challenge/ - [END]
# Enable the HTTPS certificate in REG.RU before publishing the site.
RewriteCond %{HTTP_HOST} ^cons\.sgt-h\.ru(?::[0-9]+)?$ [NC]
RewriteRule ^$ https://cons.sgt-h.ru/ksk [R=302,L]
RewriteCond %{HTTP_HOST} ^www\.sgt-h\.ru(?::[0-9]+)?$ [NC]
RewriteRule ^ https://sgt-h.ru%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^cons\.sgt-h\.ru(?::[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://cons.sgt-h.ru%{REQUEST_URI} [R=302,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://sgt-h.ru%{REQUEST_URI} [R=302,L]
RewriteRule ^(?:sgt-private|\.git|\.env|var|vendor|backups)(?:/|$) - [R=404,L,NC]
RewriteRule ^api(?:/.*)?$ api/index.php [END,QSA]
RewriteRule ^admin/?$ admin.php [L]
RewriteRule ^setup/?$ setup.php [L]
RewriteRule ^(?:ksk|geo|cabinet|privacy|consent)/?$ index.html [L]
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
</IfModule>
<IfModule php_module>
  php_flag display_errors Off
  php_flag log_errors On
  php_value upload_max_filesize 10M
  php_value post_max_size 12M
  php_value max_file_uploads 1
</IfModule>
