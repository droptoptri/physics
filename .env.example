# Node.js 24+, private persistent storage. Never expose this directory through nginx.
PORT=3000
APP_ORIGIN=http://localhost:3000
DATA_DIR=./var
# Required in production: generate with openssl rand -hex 32.
SESSION_SECRET=
# HTTPS production only; one reverse proxy (nginx) in front of Node.
TRUST_PROXY=0
# Set all mail values to enable delivery. No outbound email is attempted without them.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
